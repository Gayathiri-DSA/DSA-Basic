class Solution
{
    public static int gcd(int a, int b) 
    {   
        /* Brute Force -- tie exceeded
        int gcd=1;
        for(int i=2 ; i<=a && i<=b ; i++)
        {
           if(a%i==0 && b%i==0 )
            {
               gcd=i;
            }
        }
       return gcd; */
       
     while (b != 0) {
        a = a % b;  // Step 1: Update a with the remainder of a divided by b
        int temp = a;  // Step 2: Store the current value of a in temp
        a = b;  // Step 3: Set a to the previous value of b
        b = temp;  // Step 4: Set b to the previous value of a (stored in temp)
    }
    return a;  // When b becomes 0, a will contain the GCD
    }
}

