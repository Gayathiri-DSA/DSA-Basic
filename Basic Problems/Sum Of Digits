/*

Sum Of Digits

Difficulty: BasicAccuracy: 67.08%Submissions: 48K+Points: 1

Given a number n. Find the sum of all the digits of n.

problem link :https://www.geeksforgeeks.org/problems/sum-of-digits1742/1?page=1&difficulty=Basic,Easy&status=solved&sortBy=submissions

*/
class Solution {
    static int sumOfDigits(int n) {
        int sum=0;
        while(n>0)
        {
               int digit = n%10;
               sum+=digit;
               n=n/10;
            
        }
        return sum;
    }
}


