/*
Prime Number

Difficulty: Basic Accuracy: 22.2% Submissions: 333K+ Points: 1

Given a number n, determine whether it is a prime number or not. A prime number is a number greater than 1 that has no positive divisors other than 1 and itself.

problem link : https://www.geeksforgeeks.org/problems/prime-number2314/1?page=1&difficulty=Basic,Easy&status=solved&sortBy=submissions

*/

class Solution 
{
    static boolean isPrime(int n) 
    {
        if(n<=1) // edge case 1 has only 1 divisor not a prime
            return false;
            
        for(int i=2;i<n;i++) // start looping from 2 ; check condt (i<n) True ;
                 
        {
            if(n%i==0) // enters loop =>(n%i) false ;  i increment | else exit loop return true
                return false; 
        }
        return true;
    }
}
